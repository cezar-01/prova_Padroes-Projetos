        <mxCell id="c213" value="«enumeration»&lt;br&gt;&lt;b&gt;ResultadoProvisionamento&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1970" y="2340" width="220" height="88" as="geometry"/></mxCell>
        <mxCell id="c214" value="ACEITO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=0;fontStyle=0;" vertex="1" parent="c213"><mxGeometry y="40" width="220" height="22" as="geometry"/></mxCell>
        <mxCell id="c215" value="RECUSADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=0;fontStyle=0;" vertex="1" parent="c213"><mxGeometry y="62" width="220" height="22" as="geometry"/></mxCell>
        <mxCell id="c216" value="Componente que escolhe o provedor: único ponto alterado para incluir um provedor novo, ex.: &quot;Gcp&quot; → FabricaGcp::new (RNF03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="180" y="80" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c217" value="Client: conhece apenas abstrações. Sem if/switch sobre o provedor e sem classes concretas (RNF02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="80" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="c218" value="&lt;b&gt;Abstract Factory&lt;/b&gt;&lt;br&gt;Uma fábrica cria a família inteira (máquina, armazenamento e fila) de UM provedor: impossível misturar provedores (RNF01). Novo provedor = nova fábrica + novos produtos (RNF03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="670" y="980" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="c219" value="Produtos concretos são classes aninhadas &lt;b&gt;private&lt;/b&gt; das fábricas: só a própria fábrica consegue instanciá-los (RNF06)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="980" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="c220" value="&lt;b&gt;Singleton&lt;/b&gt; (holder idiom): config.properties lido uma única vez, com inicialização thread-safe garantida pela JVM (RNF04)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="2820" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="c221" value="&lt;b&gt;Singleton&lt;/b&gt; com acesso synchronized: registros de provisionamentos simultâneos não se perdem nem se sobrescrevem (RNF05)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="2820" width="280" height="90" as="geometry"/></mxCell>
