        <mxCell id="c207" value="+ imprimir(fatura: Fatura): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=0;fontStyle=4;" vertex="1" parent="c205"><mxGeometry y="48" width="240" height="22" as="geometry"/></mxCell>
        <mxCell id="c208" value="&lt;b&gt;Observer&lt;/b&gt;: o Lote só conhece ObservadorLote e Licitante. Novo tipo de interessado = nova classe, sem alterar o Lote (RNF01). Quem deu o lance não é notificado (comparação por identidade)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="1710" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="c209" value="&lt;b&gt;Strategy&lt;/b&gt;: sem if/switch sobre a categoria. Nova categoria = nova regra (classe nova). setRegraComissao() troca a regra em tempo de execução, sem recriar o lote (RF07/RNF02). A comissão é calculada no encerramento." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1530" y="1920" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c210" value="&lt;b&gt;Decorator&lt;/b&gt;: serviços empilháveis em qualquer combinação, ordem e quantidade, sem classes de combinação (RNF03). Novo serviço = nova subclasse." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="2450" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c211" value="Trata igualmente uma fatura com 0 ou N serviços, sem verificar quais foram contratados (RNF04)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="2210" width="260" height="70" as="geometry"/></mxCell>
